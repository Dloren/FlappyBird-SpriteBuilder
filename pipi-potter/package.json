{
  "name": "pipi-potter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pipi Potter - juego de sigilo pixel art estilo portatil retro",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "test": "node scripts/selftest.mjs",
    "cap:sync": "npx cap sync android",
    "apk": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug && cp app/build/outputs/apk/debug/app-debug.apk ../../dist/pipi-potter.apk"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "playwright": "^1.63.0",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/screen-orientation": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6"
  }
}
